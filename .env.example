# Copie para .env. Valores abaixo são só de desenvolvimento local (Docker Compose).
# Não commite .env. Produção substitui DATABASE_URL, AUTH_SECRET e ANTHROPIC_API_KEY.

# Postgres do docker compose (usuário e senha locais, iguais ao compose).
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Auth.js — preencher em H02.1. Sem valor real neste arquivo.
AUTH_SECRET=

# Anthropic — só o servidor lê, em src/ai/provider.ts (H11.1). Sem valor real neste arquivo.
ANTHROPIC_API_KEY=

# Snapshot 2026-09-24 da família Haiku (ADR-005). Confirmar o id vigente na H11.1.
AI_MODEL=claude-haiku-4-5
AI_MAX_STEPS=5
AI_MAX_OUTPUT_TOKENS=2048

BUSINESS_TIMEZONE=America/Sao_Paulo
AWAITING_PAYMENT_HOURS=48
PAYMENT_FAILURES_THRESHOLD=3
SHIPPING_SLA_DAYS=3
AI_ACTION_TTL_HOURS=24
RECENT_FAILURES_DAYS=7

# Senha dos usuários do seed (H03.1). Default só de desenvolvimento.
# O seed recusa este valor quando NODE_ENV=production.
SEED_USER_PASSWORD=dev-only-change-me
